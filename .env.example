AWS_REGION=ap-southeast-2
DATABASE_RESOURCE_ARN=arn:aws:rds:ap-southeast-2:111111111111:cluster:wm-dev-aurora-postgres
DATABASE_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-2:111111111111:secret:wm-dev-database-application-example
DATABASE_NAME=walking_meditation
GENERATION_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/111111111111/wm-dev-generation
GOOGLE_MAPS_API_KEY=replace-with-a-restricted-google-maps-key-for-local-development
OPENAI_API_KEY=replace-with-an-openai-project-key-for-local-development
OPENAI_MODEL=gpt-6-luna
ENABLE_NEARBY_CONTEXT=true
SCRIPT_FALLBACK_ENABLED=true
# Optional local/operator archive for final and raw model output. CDK injects this in dev.
GENERATION_ARCHIVE_BUCKET=
TTS_PROVIDER=disabled
TTS_VOICE_ID=Russell
TTS_ENGINE=standard
TTS_LANGUAGE_CODE=en-AU
EMAIL_VERIFICATION_LINK_BASE=https://api.example.invalid/auth/email-verification/open
PASSWORD_RESET_LINK_BASE=walkingmeditation://password-reset
JWT_SECRET_KEY=replace-with-at-least-64-random-characters-for-local-development
JWT_KEY_ID=local-current
JWT_ISSUER=walking-meditation
JWT_AUDIENCE=walking-meditation-api
AUTH_RATE_LIMIT_PEPPER=replace-with-a-separate-random-local-development-secret
EMAIL_BACKEND=file

