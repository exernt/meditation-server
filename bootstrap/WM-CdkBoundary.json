{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowRequiredWorkloadServices",
      "Effect": "Allow",
      "Action": [
        "apigateway:*",
        "budgets:*",
        "cloudformation:*",
        "cloudtrail:*",
        "cloudwatch:*",
        "ec2:*",
        "ecr:*",
        "events:*",
        "iam:Get*",
        "iam:List*",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PassRole",
        "iam:CreateOpenIDConnectProvider",
        "iam:DeleteOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint",
        "iam:AddClientIDToOpenIDConnectProvider",
        "iam:RemoveClientIDFromOpenIDConnectProvider",
        "lambda:*",
        "logs:*",
        "polly:SynthesizeSpeech",
        "rds:*",
        "rds-data:BatchExecuteStatement",
        "rds-data:BeginTransaction",
        "rds-data:CommitTransaction",
        "rds-data:ExecuteStatement",
        "rds-data:RollbackTransaction",
        "rds-db:connect",
        "s3:*",
        "secretsmanager:*",
        "ses:*",
        "sns:*",
        "sqs:*",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:PutParameter",
        "sts:AssumeRole",
        "wafv2:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowRequiredServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "rds.amazonaws.com",
            "ops.apigateway.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyWorkloadResourcesOutsideSydney",
      "Effect": "Deny",
      "NotAction": [
        "budgets:*",
        "cloudfront:*",
        "iam:*",
        "route53:*",
        "support:*",
        "sts:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        },
        "Null": {
          "aws:RequestedRegion": "false"
        }
      }
    },
    {
      "Sid": "DenyCreatingUnboundedRoles",
      "Effect": "Deny",
      "Action": "iam:CreateRole",
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "iam:PermissionsBoundary": "arn:aws:iam::*:policy/WM-CdkBoundary"
        }
      }
    },
    {
      "Sid": "DenyBoundaryRemoval",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:DeleteUserPermissionsBoundary"
      ],
      "Resource": "*"
    }
  ]
}

